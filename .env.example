# .env.example: copy to .env and fill in. Environment variables of the same name win over .env.

# Repo to copy, as owner/name (a user or an organization). It is only read.
SOURCE_REPO=source-owner/project
# Repo to create, as owner/name. It must not exist yet, or must be an earlier copy (re-running syncs).
DEST_REPO=dest-owner/project
# Visibility used when creating the destination: private | public | internal.
DEST_VISIBILITY=private
# Optional: a dotenv file (NAME=value lines) of Actions secrets to set in the destination.
# GitHub never returns secret values, so they must come from you. Keep this file out of git.
SECRETS_ENV_FILE=
# How long to wait for GitHub to mark each replayed PR as merged, and the pause between checks.
MERGE_TIMEOUT_SECONDS=60
POLL_SECONDS=2
# Where the bare clone and run logs go (defaults: ./work and ./logs).
# WORK_DIR=
# LOG_DIR=
